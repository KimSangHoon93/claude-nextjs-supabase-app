# =============================================================================
# Gather 앱 환경변수 예시 파일
# 이 파일을 복사하여 .env.local 로 이름을 변경하고 실제 값을 입력하세요.
# .env.local 은 .gitignore 에 포함되어 있으므로 Git에 커밋되지 않습니다.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase 설정 (필수)
# Supabase 대시보드 > Project Settings > API 에서 확인할 수 있습니다.
# -----------------------------------------------------------------------------

# Supabase 프로젝트 URL (필수)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable Key (필수)
# Supabase 대시보드의 anon/public key 값을 입력합니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
